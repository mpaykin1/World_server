{
  "version": "2026-09-03.v2",
  "description": "Allowlisted capabilities for Browser ChatGPT ↔ Local World_server control bridge. Worker enforces this list before any execution.",
  "maxOutputBytes": 262144,
  "defaultTimeoutMs": 120000,
  "maxConcurrentJobs": 1,
  "capabilities": {
    "repo.status": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "git status --porcelain=v1 + branch + HEAD", "status": "VERIFIED", "executor": "execRepoStatus" },
    "repo.tree": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "list tracked files / tree", "status": "IMPLEMENTED", "executor": "execRepoTree" },
    "repo.read": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "read tracked file, return sha256/size/metadata", "status": "VERIFIED", "executor": "execRepoRead" },
    "repo.search": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "grep/search across repo", "status": "IMPLEMENTED", "executor": "execRepoSearch" },
    "repo.diff": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "git diff summary for worktree", "status": "IMPLEMENTED", "executor": "execRepoDiff" },
    "repo.history": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "git log --oneline", "status": "IMPLEMENTED", "executor": "execRepoHistory" },

    "git.fetch": { "risk": "low", "timeoutMs": 60000, "worktree": "shared", "description": "git fetch origin", "status": "IMPLEMENTED", "executor": "execGitFetch" },
    "git.create_worktree": { "risk": "medium", "timeoutMs": 60000, "worktree": "isolated", "description": "create isolated worktree/branch for task", "status": "IMPLEMENTED", "executor": "ensureTaskWorktree" },
    "git.create_branch": { "risk": "medium", "timeoutMs": 30000, "worktree": "isolated", "description": "create task branch", "status": "IMPLEMENTED", "executor": "execGitCreateBranch" },
    "git.apply_patch": { "risk": "medium", "timeoutMs": 60000, "worktree": "isolated", "description": "apply patch / create file in isolated worktree", "status": "VERIFIED", "executor": "execGitApplyPatch" },
    "git.stage": { "risk": "medium", "timeoutMs": 30000, "worktree": "isolated", "description": "git stage paths", "status": "IMPLEMENTED", "executor": "execGitStage" },
    "git.commit": { "risk": "medium", "timeoutMs": 30000, "worktree": "isolated", "description": "git commit staged", "status": "IMPLEMENTED", "executor": "execGitCommit" },
    "git.push": { "risk": "high", "timeoutMs": 60000, "worktree": "isolated", "description": "git push task branch (never master)", "status": "IMPLEMENTED", "executor": "execGitPush" },
    "git.conflicts": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "check merge conflicts", "status": "IMPLEMENTED", "executor": "execGitConflicts" },

    "test.list": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "list available test scripts", "status": "IMPLEMENTED", "executor": "execTestList" },
    "test.run": { "risk": "medium", "timeoutMs": 180000, "worktree": "isolated", "description": "run single test file / npm script", "status": "VERIFIED", "executor": "execTestRun" },
    "lint.run": { "risk": "low", "timeoutMs": 60000, "worktree": "isolated", "description": "run lint / check-js", "status": "IMPLEMENTED", "executor": "execLintRun" },
    "typecheck.run": { "risk": "low", "timeoutMs": 60000, "worktree": "isolated", "description": "typecheck (if available)", "status": "PARTIAL", "executor": null },
    "build.run": { "risk": "medium", "timeoutMs": 120000, "worktree": "isolated", "description": "run build", "status": "IMPLEMENTED", "executor": "execBuildRun" },
    "benchmark.run": { "risk": "medium", "timeoutMs": 120000, "worktree": "isolated", "description": "run benchmark", "status": "PARTIAL", "executor": null },

    "agent.list": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "list available agents/workers", "status": "IMPLEMENTED", "executor": "execAgentList" },
    "agent.dispatch": { "risk": "medium", "timeoutMs": 300000, "worktree": "isolated", "description": "dispatch REAL AI (opencode→openhuman→ollama→claude) for coding task with prompt/goal/allowedPaths/tests", "status": "IMPLEMENTED", "executor": "execAgentDispatchReal" },
    "agent.status": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "query agent/task status", "status": "IMPLEMENTED", "executor": "execAgentStatus" },
    "agent.result": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "fetch agent result", "status": "IMPLEMENTED", "executor": "execAgentResult" },
    "agent.retry": { "risk": "medium", "timeoutMs": 60000, "worktree": "isolated", "description": "retry failed agent task", "status": "PARTIAL", "executor": null },
    "agent.cancel": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "cancel queued/running browser task", "status": "IMPLEMENTED", "executor": "execAgentCancel" },

    "quality.status": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "read quality reports status", "status": "IMPLEMENTED", "executor": "execQualityStatus" },
    "quality.run": { "risk": "medium", "timeoutMs": 300000, "worktree": "isolated", "description": "run minimal quality gate", "status": "PARTIAL", "executor": null },
    "quality.blockers": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "list quality blockers/gaps", "status": "IMPLEMENTED", "executor": "execQualityBlockers" },
    "quality.regressions": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "regression report", "status": "IMPLEMENTED", "executor": "execQualityRegressions" },

    "browser.open": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "playwright open (allowlist: production/preview only)", "status": "IMPLEMENTED", "executor": "execBrowserOpen" },
    "browser.scenario": { "risk": "medium", "timeoutMs": 120000, "worktree": "shared", "description": "run browser scenario (goto/click/fill/key/wait/screenshot)", "status": "IMPLEMENTED", "executor": "execBrowserScenario" },
    "browser.screenshot": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "screenshot", "status": "IMPLEMENTED", "executor": "execBrowserScreenshot" },
    "browser.console": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "browser console logs", "status": "IMPLEMENTED", "executor": "execBrowserConsole" },

    "artifact.list": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "list artifacts for task", "status": "IMPLEMENTED", "executor": "execArtifactList" },
    "artifact.read": { "risk": "low", "timeoutMs": 30000, "worktree": "shared", "description": "read artifact metadata", "status": "IMPLEMENTED", "executor": "execArtifactRead" },
    "artifact.zip": { "risk": "low", "timeoutMs": 60000, "worktree": "shared", "description": "zip artifacts", "status": "PARTIAL", "executor": null }
  }
}
