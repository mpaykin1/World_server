{
  "schemaVersion": "1.0.0",
  "system": "QUALITY_AUTOFIX_RECIPES",
  "policy": "Only exact, reversible, evidence-backed recipes may auto-apply.",
  "recipes": [
    {
      "id": "false-green-toBeTruthy",
      "kind": "replaceAll",
      "glob": [
        "e2e/**/*.js",
        "test/**/*.js"
      ],
      "from": ".toBeTruthy;",
      "to": ".toBeTruthy();",
      "risk": "low"
    },
    {
      "id": "false-green-toBeFalsy",
      "kind": "replaceAll",
      "glob": [
        "e2e/**/*.js",
        "test/**/*.js"
      ],
      "from": ".toBeFalsy;",
      "to": ".toBeFalsy();",
      "risk": "low"
    },
    {
      "id": "viewport-fit-cover",
      "kind": "htmlViewport",
      "apps": "certified",
      "risk": "low"
    },
    {
      "id": "golden-shared-runtime",
      "kind": "ensureHtmlIncludes",
      "apps": "certified",
      "includes": [
        "<link rel=\"stylesheet\" href=\"/shared/golden-ui-shell.css\">",
        "<script src=\"/shared/golden-physics.js\"></script>",
        "<script src=\"/shared/golden-ui-shell.js\"></script>",
        "<script src=\"/shared/quality-telemetry.js\"></script>"
      ],
      "risk": "low"
    }
  ]
}
