+    assert.equal(r.result, 'CODEX_DAILY_QUOTA_EXCEEDED');
+    assert.ok(r.quota);
+    assert.equal(r.quota.codexCount, 4);
+    assert.equal(r.quota.totalCount, 10);
+    assert.equal(r.quota.share, 0.4);
+    assert.match(r.reason, /exceeds the 30% cap/);
+  } finally {
+    fs.writeFileSync(REPORT_LOG, snapshot);
+  }
