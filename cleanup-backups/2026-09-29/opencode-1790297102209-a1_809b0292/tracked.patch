+test('dispatchSubtask refuses a Codex fallback when the daily share cap is exceeded, before any paid invocation', async () => {
+  const snapshot = fs.existsSync(REPORT_LOG) ? fs.readFileSync(REPORT_LOG, 'utf8') : '';
+  const now = Date.now();
+  const entries = [];
+  for (let n = 1; n <= 4; n++) entries.push(JSON.stringify({ at: new Date(now - n * 60 * 1000).toISOString(), agent: 'codex', status: 'done' }));
+  for (let n = 5; n <= 10; n++) entries.push(JSON.stringify({ at: new Date(now - n * 60 * 1000).toISOString(), agent: 'opencode', status: 'done' }));
+  try {
+    fs.writeFileSync(REPORT_LOG, entries.join('\n') + '\n');
