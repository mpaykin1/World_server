diff --git a/test/independent-review-cloudflare.test.js b/test/independent-review-cloudflare.test.js
index b4ae3318..e392fd09 100644
--- a/test/independent-review-cloudflare.test.js
+++ b/test/independent-review-cloudflare.test.js
@@ -175,3 +175,40 @@ test('allowlisted diagnostic text is strictly exact and cannot contain a key', (
   assert.equal(safeCloudflareError(new Error('Missing structured review fields '+ secret)),
     'Cloudflare request failed (details redacted)');
 });
+
+test('live-shaped Cloudflare answer obeys documented generation knobs', async () => {
+  const model = availableCloudflareModels(cfg)[1];
+  let sent, timeout;
+  const result = await requestCloudflareReview(model, patch, {}, {
+    ...cfg, systemPrompt: 'Review code', parseVerdict,
+    getJson: async (_url, options, timeoutMs) => {
+      sent = JSON.parse(options.body); timeout = timeoutMs;
+      return { success: true, result: {
+        choices: [{ finish_reason: 'stop', message: { content: JSON.stringify(pass) } }],
+        usage: { completion_tokens_details: { reasoning_tokens: 7 } }
+      } };
+    }
+  });
+  assert.equal(result.verdict, 'PASS');
+  assert.equal(result.diagnostics.finishReason, 'stop');
+  assert.equal(result.diagnostics.reasoningTokens, 7);
+  assert.equal(sent.max_completion_tokens, 2200);
+  assert.deepEqual(sent.chat_template_kwargs, { enable_thinking: false });
+  assert.equal(sent.reasoning_effort, undefined);
+  assert.equal(timeout, 38000);
+});
+
+test('Cloudflare truncation retains nonsecret diagnostics and fails closed', async () => {
+  const model = availableCloudflareModels(cfg)[2];
+  const result = await requestCloudflareReview(model, patch, {}, {
+    ...cfg, systemPrompt: 'Review code', parseVerdict,
+    getJson: async () => ({ success: true, result: {
+      choices: [{ finish_reason: 'length', message: { content: '{"verdict":"PASS"' } }]
+    } })
+  });
+  assert.equal(result.verdict, 'INCONCLUSIVE');
+  assert.equal(result.reason, 'Cloudflare response truncated');
+  assert.equal(result.diagnostics.finishReason, 'length');
+  assert.ok(result.diagnostics.contentChars > 0);
+  assert.ok(!JSON.stringify(result).includes(cfg.token));
+});
