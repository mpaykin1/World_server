+
+function quarantineUnsafe(policy, sourcePath, reason) {
+  const src = String(sourcePath || '');
+  if (!src) return { ok: false, reason: 'no source path' };
+  if (!fs.existsSync(src)) return { ok: false, reason: `source missing: ${src}` };
+  const root = safeToDeleteRoot(policy);
+  const slot = path.join(root, `item-${Date.now()}`);
