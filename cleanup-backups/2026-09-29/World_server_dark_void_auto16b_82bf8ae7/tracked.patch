+test('H3 prediction is recorded and rendered before actual manifestation, then spatial delta is recorded',async()=>{globalThis.localStorage=memory();const events=[],evidence=new ScienceEvidenceRecorder(),orig=evidence.recordH3Prediction.bind(evidence);evidence.recordH3Prediction=(...a)=>{events.push('prediction');return orig(...a)};const ghost={show:p=>events.push(`ghost:${p.blocks.length}`),showDelta:(p,a)=>{events.push('delta');return{expected:p.blocks.length,actual:a.blocks.length,matched:1,missing:1,added:1,matchRate:1/3,delta:0}}};const mk=(scale=1)=>({id:'x',intent:{type:'tower',scale,seed:7},origin:{x:0,y:2,z:0},blocks:scale>1?[{x:0,y:0,z:0,blockType:3},{x:1,y:0,z:0,blockType:3}]:[{x:0,y:0,z:0,blockType:3},{x:2,y:0,z:0,blockType:3}]});let executedIntent=null;const manifestation={engine:{},setComplexityTier(){},preview:i=>mk(typeof i==='object'?i.scale:1),execute:async i=>{executedIntent=i;events.push('execute');return mk(typeof i==='object'?i.scale:1)},stats:()=>({})};const j=new DarkVoidScienceJourney({manifestation,ghost,evidenceRecorder:evidence});j.step=2;const r=await j.handle('create a tower',manifestation);assert.equal(typeof executedIntent,'object');assert.equal(executedIntent.seed,104736);assert.equal(evidence.rows.find(x=>x.h==='H3'&&x.phase==='prediction')?.modelFamily,'seed-shift');assert.ok(events.indexOf('prediction')<events.indexOf('execute'));assert.ok(events.findIndex(x=>x.startsWith('ghost:'))<events.indexOf('execute'));assert.equal(r.counterfactualDelta.matchRate,1/3);const s=evidence.summary();assert.equal(s.H3.predictions,1);assert.equal(s.H3.preManifestation,1);assert.equal(s.H3.n,1);assert.equal(evidence.rows.find(x=>x.h==='H3'&&x.phase==='outcome')?.modelFamily,'seed-shift');assert.equal(s.H3.byFamily['seed-shift'].n,1)});
 test('production journey records H1 H2 H3 and has no terminal state after 123 sequential actions',async()=>{globalThis.localStorage=memory();const evidence=new ScienceEvidenceRecorder(),ghost={show(){},showDelta:(p,a)=>({expected:p.blocks.length,actual:a.blocks.length,matched:a.blocks.length,missing:0,added:0,matchRate:1,delta:0})};let n=0;const manifestation={engine:{},setComplexityTier(){},preview:()=>({id:'pre',intent:{type:'tower',scale:1,seed:n},origin:{x:n,y:1,z:0},blocks:[{x:n,y:1,z:0,blockType:3}]}),execute:async()=>({id:`p${n}`,intent:{type:'tower',scale:1,seed:n++},origin:{x:n,y:1,z:0},blocks:[{x:n,y:1,z:0,blockType:3},{x:n,y:2,z:0,blockType:3}]}),stats:()=>({})};const j=new DarkVoidScienceJourney({manifestation,ghost,evidenceRecorder:evidence});for(let i=0;i<123;i++){const r=await j.handle('create a tower',manifestation);assert.equal(r.created,true)}assert.equal(j.step,123);assert.equal(j.journal.verify(),true);assert.equal(PUBLIC_PRINCIPLES.length,3);assert.equal(/H4|multi.?AI/i.test(JSON.stringify(PUBLIC_PRINCIPLES)),false);const s=evidence.summary();assert.ok(s.H1.n>0&&s.H2.n>0&&s.H3.n>0);assert.equal(s.H3.preManifestation,s.H3.predictions)});
