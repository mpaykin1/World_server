@@ -68,3 +70,26 @@ test('native LOD tier routing preserves mobile GPU/network budget',()=>{
   assert.equal(levelSelection(145,'balanced',1),2);
   assert.equal(levelSelection(20,'low',2),1);
 });
+
+test('actual normal maps have non-flat red/green channels and positive blue',()=>{
+  for(const name of ['concrete-normal.png','steel-normal.png','basalt-normal.png']){
+    const report=decodeNormalQuality(fs.readFileSync(path.join(DIR,name)));
+    assert.ok(report.variation[0]>=3&&report.variation[1]>=3,name);
+    assert.ok(report.blueMean>100,name);
+  }
+});
+test('regression: all-black but structurally valid PNG normals fail inspection',()=>{
+  const sig=Buffer.from('89504e470d0a1a0a','hex');
+  const ihdr=Buffer.alloc(13);
+  ihdr.writeUInt32BE(64,0);ihdr.writeUInt32BE(64,4);
+  ihdr[8]=8;ihdr[9]=6;
+  const chunk=(type,payload)=>{
+    const h=Buffer.alloc(8);h.writeUInt32BE(payload.length,0);
+    h.write(type,4,'ascii');
+    return Buffer.concat([h,payload,Buffer.alloc(4)]);
+  };
+  const raw=Buffer.alloc(64*(1+64*4));
+  const allBlack=Buffer.concat([sig,chunk('IHDR',ihdr),
+    chunk('IDAT',zlib.deflateSync(raw)),chunk('IEND',Buffer.alloc(0))]);
+  assert.throws(()=>decodeNormalQuality(allBlack),/flat or black normal texture/);
+});
