+// CPU utilization is the one metric os.* does NOT report directly - this
+// samples os.cpus() tick counters twice over a short bounded interval and
+// derives the busy ratio. Works cross-platform (including Windows where
+// os.loadavg() is always [0,0,0]); the sampler is injectable so callers and
+// tests never depend on wall-clock timing.
+function sampleCpuTicks() {
+  const cpus = os.cpus();
+  let idle = 0;
+  let total = 0;
+  for (const cpu of cpus) {
+    const t = cpu.times || {};
+    total += (t.user || 0) + (t.nice || 0) + (t.sys || 0) + (t.idle || 0) + (t.irq || 0);
+    idle += t.idle || 0;
+  }
+  return { idle, total };
+}
+
+function cpuBusyRatio(a, b) {
+  const dTotal = b.total - a.total;
+  if (!(dTotal > 0)) return 0;
+  const dIdle = Math.max(0, b.idle - a.idle);
+  return Math.max(0, Math.min(1, (dTotal - dIdle) / dTotal));
+}
+
+function cpuUtilizationPercent({ intervalMs = 150, sampler = sampleCpuTicks } = {}) {
+  const before = sampler();
+  if (intervalMs > 0) Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, intervalMs);
+  const after = sampler();
+  return Math.round(cpuBusyRatio(before, after) * 1000) / 10;
+}
