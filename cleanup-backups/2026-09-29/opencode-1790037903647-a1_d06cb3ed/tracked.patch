+  assert.ok(entry, 'a claude-code free unit must be present in the quota ledger');
+  assert.equal(entry.cls, 'free');
+  assert.equal(entry.outcome, 'dispatched');
+});
+
+test('paid-quota block results can never false-green PASS', () => {
+  assert.equal(mc.summarizeMasterResults([{ result: 'PASS' }, { result: 'PAID_QUOTA_EXCEEDED' }]), 'PENDING');
+});
