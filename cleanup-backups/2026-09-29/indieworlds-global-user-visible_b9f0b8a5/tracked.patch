diff --git a/scripts/check-user-visibility-gate.js b/scripts/check-user-visibility-gate.js
new file mode 100644
index 00000000..8893e8f7
--- /dev/null
+++ b/scripts/check-user-visibility-gate.js
@@ -0,0 +1,19 @@
+'use strict';
+const fs=require('node:fs'),path=require('node:path');
+const root=path.resolve(__dirname,'..');
+const policy=JSON.parse(fs.readFileSync(path.join(root,'policy/user-visibility-gate.json'),'utf8'));
+const shell=fs.readFileSync(path.join(root,'shared/golden-ui-shell.js'),'utf8');
+const css=fs.readFileSync(path.join(root,'shared/golden-ui-shell.css'),'utf8');
+const gateway=fs.readFileSync(path.join(root,'world/gateway.js'),'utf8');
+const checks=[
+  ['always-visible change signal',30,/goldenWorldPulse/.test(shell)&&/#goldenWorldPulse/.test(css)],
+  ['current-world identity',20,/goldenPulseTitle/.test(shell)&&/goldenPulseStory/.test(shell)],
+  ['story/connections CTA',20,/goldenPulseOpen/.test(shell)&&/select\('worlds'\)/.test(shell)],
+  ['canonical wrapper for external worlds',20,/\/world\/\?id=/.test(shell)&&/x\.external===true/.test(gateway)],
+  ['portable discovery visible',10,/Паспорт независимого мира/.test(shell)&&/application\/vnd\.world-server\.indieworld\+json/.test(shell)]
+];
+const score=checks.reduce((n,[,w,ok])=>n+(ok?w:0),0);
+for(const [name,w,ok] of checks) console.log(`${ok?'PASS':'FAIL'} ${w}% ${name}`);
+console.log(`USER_VISIBLE_IMPACT=${score}% threshold=${policy.thresholdPercent}%`);
+if(score<policy.thresholdPercent){console.error('LINK_OUTPUT_BLOCKED');process.exit(1)}
+console.log('LINK_OUTPUT_SOURCE_GATE=PASS');
