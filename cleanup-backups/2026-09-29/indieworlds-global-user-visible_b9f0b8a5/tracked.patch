+'use strict';
+(async()=>{const q=new URLSearchParams(location.search);const id=q.get('id')||'';const frame=document.querySelector('#worldFrame');const status=document.querySelector('#worldGatewayStatus');try{const r=await fetch('/api/apps?all=1',{cache:'no-store'});if(!r.ok)throw new Error(`catalog HTTP ${r.status}`);const j=await r.json();const item=(j.inventory||[]).find(x=>x.id===id&&x.external===true&&x.worldMenu?.show&&x.url);if(!item)throw new Error('Мир не опубликован в каноническом каталоге');const u=new URL(item.url);if(u.protocol!=='https:')throw new Error('Разрешены только HTTPS-миры');document.title=`${item.title} · IMPROVE WORLD`;frame.title=item.title;frame.src=u.href;frame.addEventListener('load',()=>{status.hidden=true;},{once:true});}catch(e){status.textContent=`Не удалось открыть мир: ${e.message}`;status.dataset.error='true';}})();
