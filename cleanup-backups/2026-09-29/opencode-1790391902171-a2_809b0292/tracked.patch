diff --git a/.github/workflows/fleet-pre-exact-sha.yml b/.github/workflows/fleet-pre-exact-sha.yml
index 25880806..c56117c9 100644
--- a/.github/workflows/fleet-pre-exact-sha.yml
+++ b/.github/workflows/fleet-pre-exact-sha.yml
@@ -3,9 +3,16 @@ on:
   pull_request:
     branches: [master]
   workflow_dispatch:
+    inputs:
+      pr_number:
+        description: Existing PR to certify Ocean merge eligibility for
+        type: number
+        required: false
 
 permissions:
   contents: read
+  checks: read
+  pull-requests: read
 
 jobs:
   fleet-pre:
@@ -69,4 +76,43 @@ jobs:
           set -euo pipefail
           test -n "$CERTIFIED"
           test "$CERTIFIED" = "$EXPECTED"
-          echo "READY_FOR_OCEAN=YES SHA=$CERTIFIED"
+
+      # Certificate-SHA == head-SHA is necessary but not sufficient. Collect the
+      # remaining exact-head facts the protected integration actually needs so
+      # the decision below can fail closed instead of assuming approval.
+      - name: Collect exact-head pull request and independent review facts
+        env:
+          GH_TOKEN: ${{ github.token }}
+          EXPECTED: ${{ github.event.pull_request.head.sha || github.sha }}
+          CERTIFIED_SHA: ${{ needs.fleet-pre.outputs.sha }}
+          PR_NUMBER: ${{ github.event.pull_request.number || inputs.pr_number }}
+          CHECK_NAME: 'World Independent Adversarial Review'
+        run: |
+          set -euo pipefail
+          FACTS_DIR="$RUNNER_TEMP/ocean"
+          mkdir -p "$FACTS_DIR"
+          if test -z "${PR_NUMBER:-}"; then
+            echo "::warning::no pull request number resolved; the gate will fail closed"
+            exit 0
+          fi
+          gh api "repos/${GITHUB_REPOSITORY}/pulls/${PR_NUMBER}" > "$FACTS_DIR/pr.json"
+          gh api "repos/${GITHUB_REPOSITORY}/git/ref/heads/master" > "$FACTS_DIR/master.json"
+          # Server-side check_name filter: one JSON object, never a paginated
+          # stream, so a review run on a later page cannot be silently missed.
+          ENCODED_NAME="$(jq -rn --arg v "$CHECK_NAME" '$v | @uri')"
+          gh api "repos/${GITHUB_REPOSITORY}/commits/${EXPECTED}/check-runs?check_name=${ENCODED_NAME}&per_page=100" \
+            > "$FACTS_DIR/checks.json"
+
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ github.event.pull_request.head.sha || github.sha }}
+          persist-credentials: false
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24
+
+      - name: Fail closed unless the exact head is Ocean eligible
+        run: |
+          set -euo pipefail
+          node scripts/ocean-merge-eligibility-facts.js "$RUNNER_TEMP/ocean"
+          node scripts/ocean-merge-eligibility-gate.js "$RUNNER_TEMP/ocean/facts.json"
