+test('codex dispatch is blocked before any subprocess when the daily 30% share is exceeded', async () => {
+  // A fixture ledger (the same shared report schema every agent writes) where
+  // Codex is already 4/6 of the trailing-day work. A new Codex dispatch must
+  // be blocked with CODEX_QUOTA_EXCEEDED BEFORE invokeCodex (which is why the
+  // gate accepts agentReportsPath/quotaNow for deterministic testing).
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'wsh-codex-quota-dispatch-'));
+  const fixture = path.join(dir, 'ai-agent-reports.jsonl');
+  const at = '2026-09-22T12:00:00.000Z';
+  const lines = [
+    { at, agent: 'codex', status: 'done' },
+    { at, agent: 'codex', status: 'failed' },
+    { at, agent: 'codex', status: 'done' },
+    { at, agent: 'codex', status: 'done' },
+    { at, agent: 'opencode', status: 'done' },
+    { at, agent: 'claude-code', status: 'done' },
+  ];
+  fs.writeFileSync(fixture, lines.map((l) => JSON.stringify(l)).join('\n') + '\n');
+  const beforeCodings = readReports().length;
+  const root = mkTmpRoot();
+  const r = await mc.dispatchSubtask(root, { text: 'unresolved integration bug', agent: 'codex', taskId: 'codex-quota-blocked-test' }, { allowPaid: true, agentReportsPath: fixture, quotaNow: Date.parse(at) });
+  assert.equal(r.ok, false);
+  assert.equal(r.result, 'CODEX_QUOTA_EXCEEDED');
+  assert.ok(r.codexQuota && r.codexQuota.codex === 4 && r.codexQuota.total === 6, 'blocked decision must carry the real daily counts');
+  assert.equal(readReports().length, beforeCodings, 'a quota-blocked dispatch must not write a work entry to the shared ledger');
+});
+
+test('codex dispatch proceeds past the quota gate when today share is below the 30% cap', async () => {
+  // A ledger where Codex is 1/5 - below the cap - proves the gate does not
+  // over-block. The real Codex CLI is replaced by a stubbed adapter via the
+  // same seam style runMasterGoal already uses for dispatchFn, so this stays
+  // deterministic and never spawns a paid subprocess.
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'wsh-codex-quota-allow-'));
+  const fixture = path.join(dir, 'ai-agent-reports.jsonl');
+  const at = '2026-09-22T12:00:00.000Z';
+  const lines = [
+    { at, agent: 'codex', status: 'done' },
+    { at, agent: 'opencode', status: 'done' },
+    { at, agent: 'opencode', status: 'done' },
+    { at, agent: 'claude-code', status: 'done' },
+    { at, agent: 'world-cloud-ai', status: 'done' },
+  ];
+  fs.writeFileSync(fixture, lines.map((l) => JSON.stringify(l)).join('\n') + '\n');
+  const root = mkTmpRoot();
+  let invokedWithAllowPaid = false;
+  const r = await mc.dispatchSubtask(root, { text: 'unresolved integration bug', agent: 'codex', taskId: 'codex-quota-allow-test' }, { allowPaid: true, agentReportsPath: fixture, quotaNow: Date.parse(at), invokeCodex: async (_text, o) => { invokedWithAllowPaid = o.allowPaid === true; return { ok: true, result: 'PASS', committed: 'deadbeef' }; } });
+  assert.notEqual(r.result, 'CODEX_QUOTA_EXCEEDED', 'a 1/5 daily share must pass the quota gate');
+  assert.equal(r.result, 'PASS');
+  assert.equal(invokedWithAllowPaid, true, 'the adapter must still receive allowPaid through the gate');
+});
+
+test('a blocked codex quota can never false-green an overall PASS', () => {
+  assert.equal(mc.summarizeMasterResults([{ result: 'PASS' }, { result: 'CODEX_QUOTA_EXCEEDED' }]), 'PENDING');
+});
