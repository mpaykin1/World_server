{
  "schemaVersion": "1.0.0",
  "system": "WORLD_SERVER_SYSTEM_CONTRACTS",
  "contracts": {
    "input": {
      "canonical": [
        "shared/ai3d-playable-runtime.js",
        "shared/golden-physics.js"
      ],
      "forbiddenPatterns": [
        "const wishX = (s*cos + f*sin)",
        "new THREE.Vector3(Math.cos(yaw),0,-Math.sin(yaw))"
      ],
      "requiredBy": [
        "voxel-world",
        "ai3d-voxel-city",
        "catalog"
      ]
    },
    "ui": {
      "canonical": [
        "shared/golden-ui-shell.js",
        "shared/golden-ui-shell.css"
      ],
      "requiredBy": [
        "voxel-world",
        "ai3d-voxel-city",
        "catalog"
      ],
      "forbiddenBehavior": "persistent system/debug panels outside Golden drawer"
    },
    "collision": {
      "canonical": [
        "shared/golden-physics.js"
      ],
      "requiredBy": [
        "voxel-world",
        "ai3d-voxel-city"
      ]
    },
    "release": {
      "canonical": [
        "data/app-release-registry.json",
        "scripts/quality-regression-gate.js"
      ],
      "requiredBy": [
        "all-public-apps"
      ]
    },
    "discovery": {
      "canonical": [
        "lib/indieworlds.js",
        "scripts/export-indieworlds.js",
        "shared/golden-ui-shell.js"
      ],
      "requiredBy": [
        "all-public-apps"
      ],
      "releasePolicy": "deny-by-default",
      "publicRepresentations": [
        "application/vnd.world-server.indieworld+json",
        "application/rss+xml"
      ]
    },
    "referenceGraphics": {
      "canonical": [
        "REFERENCE_GRAPHICS.md",
        "lib/reference-frame-analyzer.js",
        "lib/reference-visual-grammar.js",
        "lib/reference-graphics-router.js",
        "lib/reference-recipe-compiler.js",
        "lib/reference-correction-planner.js"
      ],
      "requiredBy": [
        "reference-driven-graphics-tasks"
      ],
      "rules": [
        "extract measurable style before choosing a renderer",
        "keep semantic hints separate from pixel measurements",
        "reuse existing voxel/AI3D/PBR/LIGHT/sprite systems",
        "render back and correct largest perceptual mismatch first",
        "user decides visual success or failure"
      ]
    }
  }
}
