    "orientation": "vertical",
    "minimumTorsoCoverage": 0.8,
    "frontHemisphereOnly": true
  },
  "weapons": {
    "pistol": {
      "requiredHands": 1,
      "attachment": "hand",
      "allowFloating": false
    },
    "rifle": {
      "requiredHands": 2,
      "attachments": [
        "primary-hand",
        "support-hand"
      ]
    },
    "machineGun": {
      "requiredHands": 2,
      "attachments": [
        "primary-hand",
        "support-hand"
      ]
    }
  },
  "engines": {
    "web": "adapter-required",
    "godot": "adapter-required",
    "roblox": "adapter-required"
  }
}
