{
  "schemaVersion": "3.0.0",
  "coordinateContract": "engine-adapter-normalized",
  "locomotion": {
    "feetForward": {
      "source": "travel-direction",
      "minimumAlignmentDot": 0.92,
      "zeroVelocityBehavior": "preserve-last-valid-forward"
    }
  },
  "attack": {
    "directionSource": "feet-forward",
    "maximumAngularErrorDegrees": 5
  },
  "shield": {
