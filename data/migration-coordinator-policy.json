{
  "schemaVersion": "7.4.0",
  "system": "DATABASE_MIGRATION_COORDINATOR",
  "strategy": "expand-migrate-contract",
  "requireFencedLeader": true,
  "requireSnapshotBeforeApply": true,
  "requireShadowVerification": true,
  "requireExplicitApplyFlag": true,
  "applyEnv": "WORLD_SERVER_ALLOW_DB_MIGRATION",
  "allowedExtensionsVersionPinning": false,
  "defaultLockTimeoutMs": 5000,
  "defaultStatementTimeoutMs": 120000,
  "dangerousPatterns": [
    "drop table",
    "drop column",
    "alter column .* type",
    "truncate",
    "delete from .* without where"
  ],
  "contractPhaseRequiresExplicitApproval": true,
  "supabase2026Compatibility": {
    "extensionVersionPinningDeprecated": true,
    "securityInvokerPreferred": true,
    "exposedSchemaRlsRequired": true
  }
}
