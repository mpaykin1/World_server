{
  "schemaVersion": "3.0.0",
  "protectedExtensions": [
    ".png",
    ".apng",
    ".webp",
    ".jpg",
    ".jpeg",
    ".ktx2",
    ".basis",
    ".glb",
    ".gltf",
    ".fbx",
    ".obj",
    ".blend",
    ".svg"
  ],
  "protectedPathTokens": [
    "/textures/",
    "/materials/",
    "/shaders/",
    "/graphics/",
    "/models/",
    "/sprites/",
    "/assets/"
  ],
  "ignorePathTokens": [
    "/test/fixtures/",
    "/apps/ai3d-reference-test/assets/",
    "/apps/ai3d-reference-test/",
    "/assets/pixel/",
    "/public/assets/pixel/",
    "/shared/pwa-icon",
    "/visual-candidates/",
    "/worlds/sample-city/assets/",
    "/assets/fonts/ink-glyph/",
    "/assets/hanzi-strokes/",
    "/.iw-graphics-staging/",
    "/.characterforge-backups/",
    "/payload/assets/fonts/",
    "/payload/assets/hanzi-strokes/",
    "/shared/panorama360-source/",
    "/shared/panorama360/",
    "/reference/"
  ],
  "evidenceFile": "QUALITY_CHANGE_EVIDENCE.json",
  "rules": {
    "deletionForbiddenWithoutExplicitReplacement": true,
    "modifiedProtectedAssetRequiresVisualRegressionPass": true,
    "qualityDeltaMustBeNonNegative": true,
    "preservesExistingFeatures": true
  },
  "atlas": {
    "threshold": 8,
    "preferAtlas": true,
    "preferSingleArchive": true,
    "neverReplaceRequestedAPNG": true
  }
}
