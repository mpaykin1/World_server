{
  "schemaVersion": "1.0.0",
  "provider": "cloudflare",
  "service": "world-server",
  "configuration": "wrangler.jsonc",
  "canonicalOriginEnvironmentVariable": "WORLD_SERVER_CANONICAL_ORIGIN",
  "previewOriginEnvironmentVariable": "CLOUDFLARE_DEPLOYMENT_URL",
  "deployedRevisionEnvironmentVariable": "WORLD_SERVER_DEPLOYED_SHA",
  "proofEndpoint": "/api/config",
  "runtimeHeader": {
    "name": "x-world-server-config-runtime",
    "value": "cloudflare-native"
  },
  "revisionHeader": "x-world-server-deployed-revision",
  "rule": "All production and preview deploy triggers must invoke productionDeployCommand so every runtime exposes the exact source Git SHA; resolve the URL from Cloudflare deployment output or the configured stable origin, never guess a hostname or use Netlify as canonical evidence.",
  "productionDeployCommand": "npm run deploy:cloudflare:production",
  "buildRevisionSource": "WORKERS_CI_COMMIT_SHA"
}
