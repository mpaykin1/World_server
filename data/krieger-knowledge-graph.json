  "openForensicsFindings": [
    {
      "id": "portrait_forced_2_to_1",
      "type": "verified_source_root_cause_candidate",
      "file": "mainplayer.cpp",
      "anchors": [
        "sInt bh = sMin(sSystem->ConfigX/2,sSystem->ConfigY);",
        "sInt bw = 2*bh;",
        "vp.Window.Init(x0,y0,x0+bw,y0+bh);",
        "Environment->Aspect = 2.0f;"
      ],
      "statement": "The WASM port intentionally constrains the master gameplay viewport to the largest 2:1 band and fixes Environment aspect to 2.0 every paint frame. This can recreate portrait letterboxing even when CSS canvas and render targets are full-height."
    },
    {
      "id": "weapon_ui_state_divergence",
      "type": "verified_source_mechanism",
      "file": "kkriegergame.cpp",
      "statement": "A digit request is ignored unless the mapped weapon exists in Player.Weapon[]. CurrentWeapon commits only after NextWeapon differs and WeaponTimer reaches 1.0. A browser label can therefore diverge from actual game state."
    }
