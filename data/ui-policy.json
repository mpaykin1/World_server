{
  "schemaVersion": "3.0.0",
  "system": "GOLDEN_UI_POLICY",
  "mode": "release-blocking",
  "rules": {
    "compactSystemMenu": true,
    "minimumTouchTargetPx": 44,
    "mobileSafeArea": true,
    "persistentTechnicalTextOutsideMenu": false,
    "directWorldSelection": true,
    "keyboardEscapeClosesDrawer": true,
    "essentialGameplayHudAllowed": [
      "crosshair",
      "hotbar",
      "health",
      "objective",
      "context-action"
    ],
    "goldenTopToolbar": [
      "menu",
      "worlds",
      "settings",
      "info"
    ],
    "drawerCloseTargetPxMobile": 52,
    "drawerDisablesGameplayTouch": true,
    "worldMenuStyle": "newspaper",
    "worldMenuShowsAllKnownWorlds": true,
    "worldPreviewFormat": "ultra-low-webm",
    "worldPreviewMaxBytes": 100000,
    "worldPreviewLazyLoad": true,
    "worldLoreReadingLevel": "age-5-simple",
    "worldConnectionsMenu": true,
    "newTechnologyVisibleInAllWorlds": true,
    "newTechnologyVisibleWithinSeconds": 60,
    "worldTechnologyCoverageMode": "every-world-direct-or-canonical-gateway",
    "stableCanonicalUserLinksOnly": true,
    "verifyUserLinkImmediatelyBeforeDelivery": true,
    "ephemeralPreviewLinksCanBeFinal": false
  },
  "knownSystemPanels": {
    "catalog": [
      ".app-title",
      ".topHint",
      "#miniMap"
    ],
    "voxel-world": [
      "#vwHud",
      "#vwHelp",
      "#vwBack"
    ],
    "ai3d-voxel-city": [
      "header",
      ".controls",
      ".metrics"
    ]
  }
}
