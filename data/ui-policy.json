{
  "schemaVersion": "2.1.0",
  "system": "GOLDEN_UI_POLICY",
  "mode": "release-blocking",
  "rules": {
    "compactSystemMenu": true,
    "minimumTouchTargetPx": 44,
    "mobileSafeArea": true,
    "persistentTechnicalTextOutsideMenu": false,
    "directWorldSelection": true,
    "keyboardEscapeClosesDrawer": true,
    "essentialGameplayHudAllowed": [
      "crosshair",
      "hotbar",
      "health",
      "objective",
      "context-action"
    ],
    "goldenTopToolbar": [
      "menu",
      "worlds",
      "settings",
      "info"
    ],
    "drawerCloseTargetPxMobile": 52,
    "drawerDisablesGameplayTouch": true,
    "worldMenuStyle": "newspaper",
    "worldMenuShowsAllKnownWorlds": true,
    "worldPreviewFormat": "ultra-low-webm",
    "worldPreviewMaxBytes": 100000,
    "worldPreviewLazyLoad": true,
    "worldLoreReadingLevel": "age-5-simple",
    "worldConnectionsMenu": true,
    "worldConnectionCardsClickable": true,
    "worldFusionEnabled": true,
    "worldFusionAnyPair": true,
    "worldFusionUrlPattern": "/shared/world-fusion.html?a={WORLD_A}&b={WORLD_B}",
    "worldFusionPreservesSources": true,
    "worldDisplayNameMaxWords": 3,
    "worldDisplayNameForbidsSystemTokens": true,
    "worldDisplayNameRegistry": "data/world-display-names.json",
    "graphicsFirstWorlds": true,
    "primaryRendererMinViewportWidthRatio": 0.9,
    "primaryRendererMinViewportHeightRatio": 0.82,
    "maxClosedAuxiliaryOcclusionRatio": 0.12,
    "gameplayPageScrollAllowed": false
  },
  "knownSystemPanels": {
    "catalog": [
      ".app-title",
      ".topHint",
      "#miniMap"
    ],
    "voxel-world": [
      "#vwHud",
      "#vwHelp",
      "#vwBack"
    ],
    "ai3d-voxel-city": [
      "header",
      ".controls",
      ".metrics",
      ".compare > .pane:not(.viewerPane)",
      ".viewerHead",
      "#stats"
    ],
    "survival": [
      "#survivalHelp",
      "#stats",
      "#backLink",
      "#buildPanel",
      "#inventory"
    ]
  }
}
