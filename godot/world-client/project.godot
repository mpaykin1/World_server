; World_server native client - Godot project
; Shares the exact same procedural World Spec (seed, hash/noise/height/biome
; formulas) as apps/voxel-world/client.js (the web renderer) - see
; WorldGen.gd for the faithful port and its provenance comment. This is a
; second CLIENT for the same World_server, not a separate game.

config_version=5

[application]

config/name="World_server Native"
config/description="Native (Godot) client for World_server - shares the same World Spec/seed/procedural generation as the web voxel-world client."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
