# These variables are supplied automatically by the Supabase/Vercel integration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AI 3D server-side generation
AI3D_WORKER_URL=
AI3D_SHARED_SECRET=
AI3D_TOKEN_TTL_SECONDS=600
AI3D_MAX_UPLOAD_MB=25


# Pixel Panorama 360 V4
PIXEL_PANORAMA_360_STORAGE_BUCKET=panorama360
PIXEL_PANORAMA_360_PUBLIC_BASE=/shared/panorama360
PIXEL_PANORAMA_360_MAX_UPLOAD_MB=250
PIXEL_PANORAMA_GENERATOR_URL=

# CAS (.world-server-state/cas) garbage-collection limits. Defaults live in
# config/cas-gc.config.json; any of these env vars overrides that file
# without editing it. GB variants are convenience wrappers around the *_BYTES
# variants (BYTES wins if both are set). See scripts/cas-merkle-store.cjs.
# CAS_GC_ENABLED=true
# CAS_GC_KEEP_SNAPSHOTS=20
# CAS_GC_EMERGENCY_KEEP_SNAPSHOTS=5
# CAS_GC_WARN_GB=5
# CAS_GC_AUTO_GB=10
# CAS_GC_EMERGENCY_GB=20
# CAS_GC_BLOCK_ON_EMERGENCY=true
