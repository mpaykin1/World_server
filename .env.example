# These variables are supplied automatically by the Supabase/Vercel integration.
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are public/client-safe by design —
# fine to scope to Preview for all branches. SUPABASE_SECRET_KEY is the
# production service-role key and must stay restricted (never scope it to
# Preview for arbitrary branches — see SUPABASE_PREVIEW_SECRET_KEY below).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Admin Supabase access (login/register/voxel/game/quality-write endpoints)
# on Preview deployments. Deliberately separate from SUPABASE_SECRET_KEY:
# lib/env.js refuses to fall back to the production secret when
# VERCEL_ENV=preview, so an arbitrary PR/AI branch can never reach the
# production service role even if it were accidentally scoped to Preview.
# Point these at a dedicated preview/test Supabase project (its own least-
# privilege service-role key), not production. Admin-dependent preview
# endpoints fail with a clear error until this is provisioned — they don't
# silently touch production data instead.
SUPABASE_PREVIEW_URL=
SUPABASE_PREVIEW_SECRET_KEY=

# AI 3D server-side generation
AI3D_WORKER_URL=
AI3D_SHARED_SECRET=
AI3D_TOKEN_TTL_SECONDS=600
AI3D_MAX_UPLOAD_MB=25

# PostHog product analytics (Project API Key, safe for client-side exposure).
# Optional: analytics simply stay off if unset. Session Replay and Error
# Tracking are intentionally not enabled here — Sentry already covers those
# (see shared/sentry-runtime.entry.js).
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

