{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "master": true
    }
  },
  "framework": null,
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/apps.js": {
      "includeFiles": "apps/**"
    },
    "api/worlds.js": {
      "includeFiles": "data/world-graph-index.json"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/apps/catalog/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/apps/:app/",
      "destination": "/apps/:app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "outputDirectory": ".",
  "buildCommand": "node scripts/inject-sentry-runtime.js",
  "ignoreCommand": "node scripts/check-vercel-ignore.js"
}
