{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "master": true
    }
  },
  "framework": null,
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/apps.js": {
      "includeFiles": "apps/**"
    },
    "api/worlds.js": {
      "includeFiles": [
        "data/world-graph-index.json",
        "data/app-release-registry.json",
        "data/world-lore-v2.json"
      ]
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/apps/catalog/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/canon",
      "destination": "/api/worlds?__route=canon"
    },
    {
      "source": "/api/world-factory",
      "destination": "/api/worlds?__route=world-factory"
    },
    {
      "source": "/api/register",
      "destination": "/api/auth?__route=register"
    },
    {
      "source": "/api/login",
      "destination": "/api/auth?__route=login"
    },
    {
      "source": "/api/me",
      "destination": "/api/auth?__route=me"
    },
    {
      "source": "/api/logout",
      "destination": "/api/auth?__route=logout"
    },
    {
      "source": "/apps/:app/",
      "destination": "/apps/:app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "outputDirectory": ".",
  "buildCommand": "node scripts/inject-sentry-runtime.js",
  "ignoreCommand": "node scripts/check-vercel-ignore.js"
}
