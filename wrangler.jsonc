{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "world-server",
  "compatibility_date": "2026-09-11",
  "main": "cloudflare-worker.js",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "GAME_AI_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "TELEGRAM_DB",
      "database_name": "world-server-telegram-state",
      "database_id": "29b33c0d-7a0a-4a4c-a282-3fc9583e6cdb",
      "migrations_dir": "migrations/telegram-d1"
    }
  ]
}
