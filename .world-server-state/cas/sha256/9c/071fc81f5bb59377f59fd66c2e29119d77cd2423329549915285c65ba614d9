const {test,expect}=require('@playwright/test');const fs=require('fs'),path=require('path');
test('V5 WebGPU meshlet experiment preserves fallback',async({page})=>{await page.goto('/apps/catalog/',{waitUntil:'domcontentloaded'});await page.addScriptTag({url:'/shared/quality/webgpu-meshlet-experiment.js'});const r=await page.evaluate(async()=>{const idx=[];for(let i=0;i<500;i++)idx.push(i,i+1,i+2);const m=WorldMeshletExperiment.partition(idx),p=await WorldMeshletExperiment.probe();return{probe:p,count:m.length,maxVertices:Math.max(...m.map(x=>x.vertices.length)),maxTriangles:Math.max(...m.map(x=>x.triangles.length/3)),triangles:m.reduce((a,x)=>a+x.triangles.length/3,0)}});expect(r.maxVertices).toBeLessThanOrEqual(64);expect(r.maxTriangles).toBeLessThanOrEqual(126);expect(r.triangles).toBe(500);fs.writeFileSync(path.join(process.cwd(),'WEBGPU_MESHLET_REPORT.json'),JSON.stringify({schemaVersion:'5.0.0',generatedAt:new Date().toISOString(),status:r.probe.status,webgpu:r.probe.webgpu,partitionVerified:true,webglFallbackPreserved:true,...r},null,2)+'\n')});
