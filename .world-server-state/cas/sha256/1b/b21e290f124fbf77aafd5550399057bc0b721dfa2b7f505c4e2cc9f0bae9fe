# Same secret must be configured in World_server/Vercel and the GPU worker.
AI3D_SHARED_SECRET=replace-with-a-long-random-secret
AI3D_ALLOWED_ORIGINS=https://world-server.vercel.app
AI3D_MAX_UPLOAD_MB=25
AI3D_MAX_WORKERS=1
AI3D_JOB_TTL_HOURS=72
AI3D_RUNTIME_DIR=./runtime
AI3D_MODEL_DIR=./runtime/models

# External engines - do not commit their large repos/weights into World_server.
TRELLIS2_HOME=/opt/ai3d/external/TRELLIS.2
TRELLIS2_MODEL=microsoft/TRELLIS.2-4B
DEPTH_ANYTHING_HOME=/opt/ai3d/external/Depth-Anything-V2
BUILDING_GENERATOR_HOME=/opt/ai3d/external/BuildingGeneratorThreeJS
PROCGEN_MAPS_HOME=/opt/ai3d/external/bene-proggen-maps
BLENDER_BIN=blender
