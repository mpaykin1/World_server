*{box-sizing:border-box}body{margin:0;background:#090c12;color:#eef3fa;font:14px/1.45 system-ui,Segoe UI,Arial,sans-serif}header,main{max-width:1500px;margin:auto}header{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:22px 18px 10px}.eyebrow{font-size:11px;letter-spacing:.12em;color:#8fa1ba}h1{margin:3px 0 5px;font-size:24px}h2{font-size:15px;margin:0}p{margin:0;color:#aab5c5}main{padding:10px 18px 28px}.card{background:#111722;border:1px solid #2a3444;border-radius:14px;box-shadow:0 15px 45px #0006}.controls{padding:14px;display:grid;gap:11px}.row{display:flex;flex-wrap:wrap;gap:12px}label{display:grid;gap:5px;color:#aeb9c9}input,select,button{background:#171e29;color:#eef3fa;border:1px solid #344156;border-radius:8px;padding:8px}button{cursor:pointer}.progress{height:8px;background:#080b10;border-radius:99px;overflow:hidden}.progress div{width:0;height:100%;background:#ff9552;transition:width .2s}pre{white-space:pre-wrap;margin:0;background:#090d13;border-radius:9px;padding:9px;min-height:55px}.compare{display:grid;grid-template-columns:.85fr 1.4fr;gap:12px;margin-top:12px}.pane{overflow:hidden}.paneHead,.viewerHead{padding:10px 12px;border-bottom:1px solid #2a3444;display:flex;align-items:center;justify-content:space-between;gap:10px}.paneHead span,.viewerHead span{font-size:11px;color:#9eabc0}.imgWrap{height:68vh;background:#05070a;display:grid;place-items:center;padding:8px}.imgWrap img{max-width:100%;max-height:100%;object-fit:contain}.viewerHead>div:first-child{display:flex;align-items:center;gap:9px}.buttons{display:flex;gap:6px;flex-wrap:wrap}#viewer{height:68vh;background:linear-gradient(#27142f,#9a4934 55%,#120d0c);position:relative}#viewer canvas{width:100%;height:100%;display:block}#stats{padding:9px 12px;color:#aeb9c9;border-top:1px solid #2a3444}#health{padding:6px 9px;border:1px solid #304158;border-radius:999px;color:#b9c6d7}.evidence{margin-top:12px;padding:12px;display:grid;gap:7px}.evidence>div{display:flex;justify-content:space-between;gap:12px}.evidence span{font-weight:700}.evidence p{font-size:12px}@media(max-width:900px){.compare{grid-template-columns:1fr}.imgWrap,#viewer{height:52vh}}

.metrics{margin-top:12px;padding:9px 12px;display:flex;flex-wrap:wrap;gap:8px}.metrics span{border:1px solid #2f3a4c;border-radius:999px;padding:4px 8px;background:#0b1018;color:#c6d1df}.metrics b{font-weight:700}.viewerHead div{flex-wrap:wrap}
