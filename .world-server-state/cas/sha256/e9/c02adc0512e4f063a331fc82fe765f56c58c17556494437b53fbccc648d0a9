{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/apps.js": {
      "includeFiles": "apps/**"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/apps/catalog/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/apps/:app/",
      "destination": "/apps/:app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/offline.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "outputDirectory": ".",
  "buildCommand": "npm run build"
}
