#!/usr/bin/env node
'use strict';
const fs=require('node:fs');const path=require('node:path');const {spawnSync}=require('node:child_process');const {scanSecurity}=require('../lib/quality/security-gate');
function walk(d,o=[]){if(!fs.existsSync(d))return o;for(const e of fs.readdirSync(d,{withFileTypes:true})){if(['node_modules','.git','.vercel','dist','build'].includes(e.name))continue;const f=path.join(d,e.name);e.isDirectory()?walk(f,o):o.push(f);}return o;}const report=scanSecurity(walk(process.cwd()),process.cwd());if(process.argv.includes('--online-audit')){const r=spawnSync('npm audit --omit=dev --audit-level=high --json',{shell:true,encoding:'utf8',timeout:120000});report.npmAudit={status:r.status,output:(r.stdout||r.stderr||'').slice(-12000)};if(r.status!==0)report.ok=false;}fs.mkdirSync('data/quality-autopilot',{recursive:true});fs.writeFileSync('data/quality-autopilot/security-gate.json',JSON.stringify(report,null,2)+'\n');console.log(`[QUALITY_SECURITY] ok=${report.ok} findings=${report.findings.length}`);if(!report.ok)process.exitCode=2;
