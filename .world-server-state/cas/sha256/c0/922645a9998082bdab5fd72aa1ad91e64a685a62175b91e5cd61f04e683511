function texKey(t){if(!t)return null;return[t.uuid,t.colorSpace,t.wrapS,t.wrapT,t.magFilter,t.minFilter,t.anisotropy,t.flipY].join(':')}
function signature(m){if(!m)return'null';const keys=['type','transparent','opacity','alphaTest','side','depthTest','depthWrite','vertexColors','roughness','metalness','shininess','clearcoat','clearcoatRoughness','envMapIntensity'];const o={};for(const k of keys)if(k in m)o[k]=m[k];for(const k of['color','emissive','specular'])if(m[k]?.getHexString)o[k]=m[k].getHexString();for(const k of['map','normalMap','roughnessMap','metalnessMap','aoMap','emissiveMap','alphaMap','lightMap'])o[k]=texKey(m[k]);return JSON.stringify(o)}
export function deduplicateExactMaterials(root){const canonical=new Map();let inspected=0,reused=0;root?.traverse?.(o=>{if(!o.isMesh||!o.material)return;const arr=Array.isArray(o.material)?o.material:[o.material],next=[];for(const m of arr){inspected++;if(m?.userData?.qualityNoDedup){next.push(m);continue}const s=signature(m),hit=canonical.get(s);if(hit&&hit!==m){next.push(hit);reused++;}else{canonical.set(s,m);next.push(m)}}o.material=Array.isArray(o.material)?next:next[0]});return{inspected,reused,unique:canonical.size,exactOnly:true,sourceMaterialsModified:false,visualResponseChanged:false};}
