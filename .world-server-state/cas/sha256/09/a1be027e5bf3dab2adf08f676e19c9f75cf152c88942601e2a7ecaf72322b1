#!/usr/bin/env node
'use strict';
const fs=require('node:fs');const path=require('node:path');const {evaluateTelemetry}=require('../lib/quality/telemetry-gate');
function arg(n,f=null){const i=process.argv.indexOf(n);return i>=0&&process.argv[i+1]&&!process.argv[i+1].startsWith('--')?process.argv[i+1]:f;}function write(f,v){fs.mkdirSync(path.dirname(f),{recursive:true});fs.writeFileSync(f,JSON.stringify(v,null,2)+'\n');}
function metrics(report){const rs=(report.results||[]);const nums=k=>rs.map(r=>r.metrics?.[k]).filter(Number.isFinite);const avg=k=>{const a=nums(k);return a.length?a.reduce((x,y)=>x+y,0)/a.length:null};return{fpsP50:avg('fpsP50'),fpsP95:avg('fpsP95'),memoryMb:avg('memoryMb'),errorRate:rs.length?rs.filter(r=>(r.pageErrors?.length||0)+(r.consoleErrors?.length||0)>0).length/rs.length:0,crashRate:rs.length?rs.filter(r=>!r.ok).length/rs.length:0,webglContextLossRate:rs.length?rs.filter(r=>(r.gpu?.webglContextLosses||0)>0).length/rs.length:0};}
const b=JSON.parse(fs.readFileSync(arg('--baseline'),'utf8')),c=JSON.parse(fs.readFileSync(arg('--candidate'),'utf8'));const bm=metrics(b),cm=metrics(c);const gate=evaluateTelemetry(bm,cm);const out={baseline:bm,candidate:cm,gate};write(arg('--out','data/quality-autopilot/telemetry-compare.json'),out);console.log(`[QUALITY_TELEMETRY_COMPARE] status=${gate.status} failed=${gate.failed.join(',')}`);if(gate.status==='rollback')process.exitCode=2;
