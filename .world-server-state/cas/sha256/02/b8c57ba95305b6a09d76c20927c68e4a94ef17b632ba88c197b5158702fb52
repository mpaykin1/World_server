#!/usr/bin/env node
'use strict';const {heartbeat,claimCpuJob,cpuCapabilities}=require('../lib/quality/runtime-worker-bridge-v11');(async()=>{const mode=process.argv[2]||'status';if(mode==='status'){console.log(JSON.stringify({ok:true,status:'PASS',capabilities:cpuCapabilities()},null,2));return;}if(mode==='heartbeat'){const r=await heartbeat();console.log(JSON.stringify(r,null,2));if(!r.ok)process.exitCode=2;return;}if(mode==='claim'){const r=await claimCpuJob();console.log(JSON.stringify(r,null,2));if(!r.ok)process.exitCode=2;return;}throw new Error('usage: status|heartbeat|claim');})().catch(e=>{console.error(e);process.exitCode=2});
