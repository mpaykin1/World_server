function runCommand(argv,timeoutMs,cwd=ROOT){if(!Array.isArray(argv)||argv.length<1)return{pass:false,reason:'no-command'};const [cmd,...args]=argv;if(!commandExists(cmd))return{pass:false,reason:'tool-unavailable',cmd};try{const o=cp.execFileSync(cmd,args,{cwd,encoding:'utf8',stdio:['ignore','pipe','pipe'],timeout:timeoutMs});return{pass:true,cmd:[cmd,...args].join(' '),stdout:String(o||'').slice(-2000)}}catch(e){return{pass:false,cmd:[cmd,...args].join(' '),code:e.status??1,stderr:String(e.stderr||e.stdout||e.message||'').slice(-2000)}}}
