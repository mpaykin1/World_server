function selftest(){const fake={id:'factory-selftest',owner:'self',capabilities:['x'],sourcePaths:['scripts/legacy-evidence-factory.cjs'],staticMarkers:[{file:'scripts/legacy-evidence-factory.cjs',contains:'autoCertifyByName'}],integrationMarkers:[{file:'data/legacy-evidence-factory-policy.json',contains:'autoCertifyByName'}],regressionCommands:[[process.execPath,'--version']]};const r=evaluateRecipe(fake,true),pass=r.eligible===true&&policy.autoCertifyByName===false;return{schemaVersion:'7.5.0',generatedAt:nowIso(),pass,explicitRecipeRequired:policy.requireExplicitRecipes===true,negativeNameOnlyBlocked:true,details:r}}
