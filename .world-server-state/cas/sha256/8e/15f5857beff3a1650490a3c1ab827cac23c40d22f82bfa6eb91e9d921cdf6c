#!/usr/bin/env node
'use strict';
const fs=require('fs'),path=require('path');const ROOT=process.cwd(),mem=JSON.parse(fs.readFileSync(path.join(ROOT,'data/quality-improvement-memory.json'),'utf8')),policy=JSON.parse(fs.readFileSync(path.join(ROOT,'data/bayesian-quality-policy.json'),'utf8')),rows=[];
for(const m of mem.items||[]){const n=Number(m.attempts||0),s=Number(m.successes||0),f=Number(m.failures||0),alpha=policy.betaPrior.alpha+s,beta=policy.betaPrior.beta+f,successMean=alpha/(alpha+beta),delta=(policy.deltaPrior.mean*policy.deltaPrior.weight+Number(m.cumulativeDelta||0))/(policy.deltaPrior.weight+n),uncertainty=Math.sqrt(alpha*beta/((alpha+beta)**2*(alpha+beta+1))),value=successMean*Math.max(0,delta+1)+policy.explorationBonus*uncertainty;rows.push({fingerprint:m.fingerprint,actionKind:m.actionKind,systemArea:m.systemArea,attempts:n,posteriorSuccess:successMean,posteriorDelta:delta,uncertainty,expectedValue:value,neverRetry:!!m.neverRetry})}
rows.sort((a,b)=>b.expectedValue-a.expectedValue);const out={generatedAt:new Date().toISOString(),predictions:rows,top:rows.filter(x=>!x.neverRetry).slice(0,20)};fs.writeFileSync(path.join(ROOT,'BAYESIAN_QUALITY_PREDICTION.json'),JSON.stringify(out,null,2)+'\n');console.log(`[BAYESIAN_QUALITY] patterns=${rows.length} top=${out.top[0]?.actionKind||'none'}`);
