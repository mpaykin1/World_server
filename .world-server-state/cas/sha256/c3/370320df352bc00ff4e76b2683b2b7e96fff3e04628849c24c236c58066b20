  "requiredEvidenceClasses": ["static", "integration", "regression"],
  "maxCommandSeconds": 120,
  "generatedContractsFile": "data/generated-legacy-function-contracts.json",
  "reportFile": "LEGACY_EVIDENCE_FACTORY_REPORT.json",
