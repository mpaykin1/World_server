self.onmessage=e=>{try{const m=e.data,p=new Float32Array(m.position),ix=new Uint32Array(m.index),tris=ix.length/3,b=new Float32Array(tris*6),c=new Float32Array(tris*3);for(let t=0;t<tris;t++){let minx=Infinity,miny=Infinity,minz=Infinity,maxx=-Infinity,maxy=-Infinity,maxz=-Infinity;for(let j=0;j<3;j++){const v=ix[t*3+j]*3,x=p[v],y=p[v+1],z=p[v+2];minx=Math.min(minx,x);miny=Math.min(miny,y);minz=Math.min(minz,z);maxx=Math.max(maxx,x);maxy=Math.max(maxy,y);maxz=Math.max(maxz,z);}b.set([minx,miny,minz,maxx,maxy,maxz],t*6);c.set([(minx+maxx)/2,(miny+maxy)/2,(minz+maxz)/2],t*3);}self.postMessage({ok:true,triangleOffset:m.triangleOffset,bounds:b.buffer,centroids:c.buffer},[b.buffer,c.buffer]);}catch(error){self.postMessage({ok:false,error:String(error?.stack||error)});}};
