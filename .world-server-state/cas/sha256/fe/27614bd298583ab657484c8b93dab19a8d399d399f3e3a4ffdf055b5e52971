#goldenUiShell{position:fixed;inset:0;z-index:2147482500;pointer-events:none;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#fff}
#goldenUiShell svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
#goldenToolbar{position:absolute;left:max(10px,env(safe-area-inset-left));top:max(10px,env(safe-area-inset-top));display:flex;gap:7px;pointer-events:auto}
#goldenToolbar button,#goldenDrawerClose{width:44px;height:44px;border-radius:13px;border:1px solid rgba(255,255,255,.2);background:rgba(12,16,22,.72);color:#fff;display:grid;place-items:center;backdrop-filter:blur(12px);box-shadow:0 5px 20px rgba(0,0,0,.22);cursor:pointer}
#goldenToolbar button:focus-visible,#goldenDrawerClose:focus-visible,.goldenAction:focus-visible,.goldenWorldLink:focus-visible{outline:2px solid white;outline-offset:2px}
#goldenDrawer{position:absolute;left:max(10px,env(safe-area-inset-left));top:calc(max(10px,env(safe-area-inset-top)) + 52px);width:min(360px,calc(100vw - 20px));max-height:min(72vh,620px);overflow:auto;opacity:0;transform:translateY(-8px) scale(.98);pointer-events:none;transition:.16s ease;border:1px solid rgba(255,255,255,.18);border-radius:17px;background:rgba(10,14,20,.9);backdrop-filter:blur(18px);box-shadow:0 18px 50px rgba(0,0,0,.38)}
#goldenDrawer.open{opacity:1;transform:none;pointer-events:auto}
#goldenDrawer>header{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 10px 6px 14px;position:sticky;top:0;background:rgba(10,14,20,.93);z-index:2}
#goldenDrawerClose{width:38px;height:38px;border-radius:11px}
.goldenTab{padding:10px 14px 14px}.goldenTab[hidden]{display:none!important}
#goldenPackedPanels>*[data-golden-packed="true"]{position:static!important;inset:auto!important;left:auto!important;right:auto!important;top:auto!important;bottom:auto!important;transform:none!important;width:auto!important;max-width:100%!important;min-width:0!important;margin:0 0 10px!important;border-radius:12px!important}
#goldenPackedPanels .topHint{display:block!important}
.goldenAction,.goldenWorldLink{box-sizing:border-box;display:block;width:100%;min-height:44px;padding:11px 12px;margin:7px 0;border-radius:11px;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.08);color:#fff;text-decoration:none;text-align:left;font:600 14px system-ui;cursor:pointer}
.goldenWorldLink:hover,.goldenAction:hover{background:rgba(255,255,255,.14)}
.golden-minimal-ui #targetInfo{display:none!important}
@media(max-width:800px),(pointer:coarse){#goldenToolbar{gap:5px}#goldenToolbar button{width:46px;height:46px}#goldenDrawer{top:calc(max(10px,env(safe-area-inset-top)) + 54px);max-height:68vh}}
