:root {
  color-scheme: dark;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif;
}
* { box-sizing: border-box; }
html, body, #app { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #05070b; }
body { touch-action: none; overscroll-behavior: none; }
#viewport { position: fixed; inset: 0; width: 100%; height: 100%; display: block; outline: none; }
.hidden { display: none !important; }
.panel {
  position: fixed;
  z-index: 100;
  left: 50%; top: 50%; transform: translate(-50%, -50%);
  min-width: min(88vw, 360px); max-width: min(88vw, 620px);
  padding: 22px;
  border-radius: 16px;
  background: rgba(8, 10, 15, .86);
  border: 1px solid rgba(255,255,255,.16);
  backdrop-filter: blur(14px);
  box-shadow: 0 20px 70px rgba(0,0,0,.5);
  text-align: center;
  pointer-events: auto;
}
.loading { display: flex; align-items: center; justify-content: center; gap: 14px; }
.spinner { width: 22px; height: 22px; border-radius: 50%; border: 2px solid #ffffff33; border-top-color: #fff; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.brand { opacity: .65; font-size: 12px; letter-spacing: .18em; }
.world-title { margin-top: 8px; font-size: clamp(24px, 5vw, 42px); font-weight: 800; }
.quality-status { margin: 12px 0 18px; font-size: 13px; letter-spacing: .08em; }
.quality-status.pass { color: #9df7b4; }
.quality-status.fail { color: #ff9d9d; }
#enterButton {
  position: relative;
  z-index: 120;
  width: 100%; min-height: 58px;
  border: 0; border-radius: 12px;
  font: inherit; font-weight: 800; font-size: 16px;
  color: #090b10; background: #fff;
  cursor: pointer; touch-action: manipulation;
}
#enterButton:active { transform: translateY(1px); }
#enterButton:disabled { opacity: .45; cursor: wait; }
.hint { margin-top: 12px; opacity: .64; font-size: 12px; line-height: 1.45; }
.mobile-hint { display: none; }
.hud { position: fixed; inset: 0; z-index: 20; pointer-events: none; }
.crosshair { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); font-size: 20px; opacity: .72; text-shadow: 0 1px 4px #000; }
.debug-badge { position: absolute; left: 12px; top: calc(12px + env(safe-area-inset-top)); font-size: 11px; line-height: 1.35; white-space: pre; padding: 8px 10px; border-radius: 8px; background: rgba(0,0,0,.52); }
.mobile-controls { position: fixed; z-index: 40; inset: 0; pointer-events: none; }
.move-zone { position: absolute; left: 0; bottom: 0; width: 50%; height: 55%; pointer-events: auto; touch-action: none; }
.look-zone { position: absolute; right: 0; top: 0; width: 58%; height: 100%; pointer-events: auto; touch-action: none; }
.stick-base { position: absolute; left: max(22px, env(safe-area-inset-left)); bottom: max(26px, env(safe-area-inset-bottom)); width: 132px; height: 132px; border-radius: 50%; border: 1px solid #ffffff2d; background: #ffffff12; }
.stick-knob { position: absolute; left: 50%; top: 50%; width: 58px; height: 58px; margin: -29px; border-radius: 50%; background: #ffffffb8; box-shadow: 0 4px 18px #0008; transform: translate(0,0); }
.jump-button { position: absolute; z-index: 45; right: max(24px, env(safe-area-inset-right)); bottom: max(32px, env(safe-area-inset-bottom)); width: 78px; height: 78px; border-radius: 50%; border: 1px solid #ffffff55; background: #ffffffd9; color: #0a0c10; font: 800 34px/1 system-ui; pointer-events: auto; touch-action: manipulation; }
.fatal { text-align: left; }
.fatal-title { font-weight: 900; color: #ffaaaa; margin-bottom: 12px; }
#fatalText { margin: 0; max-height: 55vh; overflow: auto; white-space: pre-wrap; font-size: 12px; color: #f1f1f1; }
@media (pointer: coarse), (max-width: 900px) {
  .desktop-hint { display: none; }
  .mobile-hint { display: block; }
  .crosshair { opacity: .5; }
}
