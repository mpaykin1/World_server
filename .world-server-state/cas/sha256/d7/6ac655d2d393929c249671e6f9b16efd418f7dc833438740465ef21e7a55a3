#!/usr/bin/env node
'use strict';
const fs=require('node:fs');const {spawnSync}=require('node:child_process');
function arg(n,f='master'){const i=process.argv.indexOf(n);return i>=0&&process.argv[i+1]?process.argv[i+1]:f;}const base=arg('--base-ref','master');const d=spawnSync(`git diff --name-only ${base}`,{shell:true,encoding:'utf8'});const files=(d.stdout||'').split(/\r?\n/).filter(f=>/^(supabase\/migrations|migrations)\/.*\.sql$/i.test(f));const findings=[];for(const f of files){if(!fs.existsSync(f))continue;const t=fs.readFileSync(f,'utf8');const destructive=/\b(DROP\s+(TABLE|COLUMN|SCHEMA)|TRUNCATE\s+TABLE)\b/i.test(t);const allowed=/quality-allow-destructive/i.test(t);if(destructive&&!allowed)findings.push({file:f,kind:'destructive-migration-without-explicit-allow'});if(!/\b(begin|start\s+transaction)\b/i.test(t))findings.push({file:f,kind:'migration-without-explicit-transaction',severity:'warning'});}const hard=findings.filter(x=>!x.severity);const r={ok:hard.length===0,base,files,findings};fs.mkdirSync('data/quality-autopilot',{recursive:true});fs.writeFileSync('data/quality-autopilot/migration-gate.json',JSON.stringify(r,null,2)+'\n');console.log(`[QUALITY_MIGRATION] files=${files.length} ok=${r.ok}`);if(!r.ok)process.exitCode=2;
