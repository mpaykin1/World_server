'use strict';const crypto=require('node:crypto');
function canonical(x){if(Array.isArray(x))return '['+x.map(canonical).join(',')+']';if(x&&typeof x==='object')return '{'+Object.keys(x).sort().map(k=>JSON.stringify(k)+':'+canonical(x[k])).join(',')+'}';return JSON.stringify(x);}
function hash(x){return crypto.createHash('sha256').update(typeof x==='string'?x:canonical(x)).digest('hex');}
function createAttestation(input,secret=''){const body={version:9,createdAt:input.createdAt||new Date().toISOString(),commitSha:input.commitSha||null,deploymentId:input.deploymentId||null,candidateUrl:input.candidateUrl||null,canaryPercent:input.canaryPercent??null,evidenceHashes:(input.evidence||[]).map(e=>({name:e.name,sha256:hash(e.value)})),previousAttestationHash:input.previousAttestationHash||null};const attestationHash=hash(body),signature=secret?crypto.createHmac('sha256',secret).update(attestationHash).digest('hex'):null;return {...body,attestationHash,signature,signed:Boolean(secret)};}
function verifyAttestation(a,secret=''){const {attestationHash,signature,signed,...body}=a;const expected=hash(body);if(expected!==attestationHash)return {ok:false,reason:'hash-mismatch'};if(signed){if(!secret)return {ok:false,reason:'secret-required'};const sig=crypto.createHmac('sha256',secret).update(attestationHash).digest('hex');if(sig!==signature)return {ok:false,reason:'signature-mismatch'};}return {ok:true};}
module.exports={canonical,hash,createAttestation,verifyAttestation};
