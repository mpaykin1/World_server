:root {
  color-scheme: dark;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #080a0d;
  color: #f3f6fa;
}
* { box-sizing: border-box; }
body { margin: 0; min-height: 100vh; background: radial-gradient(circle at 20% 0%, #1b2638 0, #080a0d 38rem); }
button, input { font: inherit; }
.shell { width: min(1080px, calc(100% - 32px)); margin: 0 auto; padding: 52px 0 80px; }
.hero { max-width: 760px; margin-bottom: 26px; }
.eyebrow { color: #8fa6c9; font-size: 12px; letter-spacing: .16em; margin: 0 0 12px; }
h1 { margin: 0; font-size: clamp(38px, 8vw, 78px); line-height: .96; letter-spacing: -.045em; }
.lede { color: #b6c0cf; font-size: 17px; line-height: 1.55; max-width: 680px; }
.panel, .job { border: 1px solid #263145; background: rgba(12, 16, 23, .82); box-shadow: 0 24px 80px rgba(0,0,0,.28); border-radius: 24px; backdrop-filter: blur(16px); }
.panel { padding: 18px; }
.drop { min-height: 180px; border: 1px dashed #52637d; border-radius: 18px; display: grid; place-content: center; text-align: center; cursor: pointer; transition: .18s ease; background: rgba(255,255,255,.025); }
.drop.drag, .drop:hover { border-color: #d5e4ff; background: rgba(151,190,255,.08); transform: translateY(-1px); }
.drop input { position: absolute; opacity: 0; pointer-events: none; }
.drop-title { font-size: 22px; font-weight: 700; }
.drop-sub { color: #8592a4; margin-top: 7px; }
.controls { display: flex; justify-content: space-between; gap: 16px; align-items: center; padding-top: 16px; }
.toggle { display: flex; gap: 9px; align-items: center; color: #c9d2df; font-size: 14px; }
button, .download { border: 1px solid #334057; color: #f5f8ff; background: #172033; padding: 10px 14px; border-radius: 12px; text-decoration: none; cursor: pointer; }
.queue { display: grid; gap: 14px; margin-top: 18px; }
.job { display: grid; grid-template-columns: 128px minmax(0, 1fr); gap: 18px; padding: 16px; }
.preview { width: 128px; height: 128px; object-fit: contain; border-radius: 14px; background: #050608; border: 1px solid #202a39; }
.job h2 { margin: 2px 0 4px; font-size: 17px; overflow-wrap: anywhere; }
.meta { color: #8492a7; font-size: 13px; margin: 0 0 12px; }
.status { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: #d8e5f7; }
.status::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: currentColor; box-shadow: 0 0 16px currentColor; }
.status.ok { color: #8be5b2; }
.status.error { color: #ff8d8d; }
.issues { display: flex; flex-wrap: wrap; gap: 7px; margin: 12px 0; }
.badge { padding: 5px 8px; border-radius: 999px; background: #242d3c; color: #b8c5d8; font-size: 11px; }
.actions { display: flex; flex-wrap: wrap; gap: 9px; align-items: center; }
.small { color: #8390a3; font-size: 12px; }
@media (max-width: 650px) {
  .shell { width: min(100% - 20px, 1080px); padding-top: 28px; }
  .controls { align-items: flex-start; flex-direction: column; }
  .job { grid-template-columns: 88px minmax(0,1fr); }
  .preview { width: 88px; height: 88px; }
}
